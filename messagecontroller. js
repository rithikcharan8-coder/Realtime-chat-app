const Message = require('../models/Message');

// GET /api/messages/:room?limit=50
// Returns message history for a room, oldest first.
async function getMessagesByRoom(req, res) {
  try {
    const { room } = req.params;
    const limit = Math.min(parseInt(req.query.limit, 10) || 50, 200);

    const messages = await Message.find({ room })
      .sort({ timestamp: -1 })
      .limit(limit)
      .lean();

    res.status(200).json(messages.reverse());
  } catch (error) {
    res.status(500).json({ message: 'Failed to fetch messages', error: error.message });
  }
}

// POST /api/messages
// Lets non-socket clients (e.g. a bot, a mobile client, tests) persist a message via REST.
// The socket handler has its own save path for live chat traffic — this is the API-only route.
async function createMessage(req, res) {
  try {
    const { room, sender, content } = req.body;

    if (!room || !sender || !content) {
      return res.status(400).json({ message: 'room, sender, and content are required' });
    }

    const message = await Message.create({ room, sender, content });
    res.status(201).json(message);
  } catch (error) {
    res.status(500).json({ message: 'Failed to create message', error: error.message });
  }
}

module.exports = { getMessagesByRoom, createMessage };
